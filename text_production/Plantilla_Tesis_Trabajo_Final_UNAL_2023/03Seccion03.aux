\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.1}Aprendizaje federado en el contexto de herbarios digitales}{20}{subsection.3.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {\textbf  {3-4}}{\ignorespaces Arquitectura federada para la detección de artefactos en registros digitales de herbario. Cada nodo institucional (UNAL: 6 clases, Melbourne: 11 clases) entrena localmente un modelo YOLOv8 con sus propios datos, que nunca abandonan la institución. Solo los pesos del \textit  {backbone} el extractor de características compartido se envían al servidor de agregación mediante FedAvg. Las cabezas de clasificación locales y las máscaras de clase (destacadas en naranja) permanecen en cada nodo, evitando la confusión entre los vocabularios de etiquetado de ambas instituciones.}}{21}{figure.caption.13}\protected@file@percent }
\newlabel{fig:federated_herbarium}{{\textbf  {3-4}}{21}{Arquitectura federada para la detección de artefactos en registros digitales de herbario. Cada nodo institucional (UNAL: 6 clases, Melbourne: 11 clases) entrena localmente un modelo YOLOv8 con sus propios datos, que nunca abandonan la institución. Solo los pesos del \textit {backbone} el extractor de características compartido se envían al servidor de agregación mediante FedAvg. Las cabezas de clasificación locales y las máscaras de clase (destacadas en naranja) permanecen en cada nodo, evitando la confusión entre los vocabularios de etiquetado de ambas instituciones}{figure.caption.13}{}}
